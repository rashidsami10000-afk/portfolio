---
// src/components/Header.astro
import { withBase } from '../utils/paths';

const links = [
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];

const email = 'rashidsami10000@gmail.com';
const github = 'https://github.com/rashidsami10000-afk';
const linkedin = 'https://www.linkedin.com/in/rashid-ali-9445903a1/';
---
<div class="scroll-progress" data-progress aria-hidden="true"></div>

<header class="site-header">
  <div class="header-pill">
    <a class="logo" href={withBase('/')} aria-label="Rashid Ali — home">
      <span class="logo__mark" aria-hidden="true">
        <i></i><i></i><i></i>
        <i></i><i></i><i></i>
        <i></i><i></i><i></i>
      </span>
      <span class="logo__name">Rashid Ali</span>
    </a>

    <span class="status">
      <span class="status__dot" aria-hidden="true"></span>
      Open to work
    </span>

    <button
      class="menu-btn"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="menu" id="site-menu" data-menu data-open="false" aria-hidden="true" inert>
  <nav aria-label="Site menu">
    <ul class="menu__list">
      {links.map((link, i) => (
        <li class="menu__item" style={`--i:${i}`}>
          <a class="menu__link" href={withBase(link.href)} data-menu-link>
            <span>{link.label}</span>
            <span class="menu__index">0{i + 1}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="menu__meta mono">
    <a href={`mailto:${email}`}>{email}</a>
    <span>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      {' / '}
      <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </span>
  </div>
</div>
