---
// src/pages/about.astro
import Layout from '../components/Layout.astro';
---
<Layout title="About — Rashid Ali" description="About Rashid Ali, ML engineer and researcher.">
  <section class="max-w-3xl mx-auto py-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-6">About me</h1>
    <p class="text-lg mb-6">
      I'm Rashid Ali, an ML engineer and researcher. I build scalable AI systems and
      explore new algorithms, with a focus on turning research ideas into working software.
    </p>
    <p class="text-lg mb-6">
      My path started with programming, continued through a computer science degree, and now
      centres on connecting research breakthroughs with production-ready applications.
    </p>
    <p class="text-lg mb-6">
      Outside of work I contribute to open-source projects, read research papers, and help
      newer developers get started.
    </p>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      This bio is a placeholder — replace it with your own story in
      <code>src/pages/about.astro</code>.
    </p>
  </section>
</Layout>
