---
// src/pages/index.astro
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';

const projects = await getCollection('projects');
const featured = projects.slice(0, 3);
const skills = ['Machine Learning', 'Python', 'Data Engineering', 'Research', 'Web'];
---
<Layout
  title="Rashid Ali — ML Engineer & Researcher"
  description="Portfolio of Rashid Ali, an ML engineer and researcher building practical, research-informed AI systems."
>
  <div class="flex flex-col">
    <!-- Hero -->
    <section class="py-16 md:py-24 bg-gradient-to-r from-indigo-700 to-purple-800 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-4">Hi, I'm Rashid Ali</h1>
        <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto text-indigo-50">
          ML engineer and researcher building real-world AI systems — from data pipelines to models in production.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={withBase('/projects')} class="px-6 py-3 bg-white text-indigo-800 font-semibold rounded-lg hover:bg-indigo-50">
            View projects
          </a>
          <a href={withBase('/resume')} class="px-6 py-3 bg-indigo-900 text-white font-semibold rounded-lg hover:bg-indigo-950">
            View resume
          </a>
          <a href={withBase('/contact')} class="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-indigo-800">
            Contact
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="container mx-auto px-4 py-12" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="text-2xl md:text-3xl font-bold mb-6 text-center text-gray-900 dark:text-gray-100">
        Featured projects
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <p class="mt-8 text-center">
        <a href={withBase('/projects')} class="text-indigo-700 dark:text-indigo-300 font-semibold underline-offset-4 hover:underline">
          See all projects
        </a>
      </p>
    </section>

    <!-- Skills Strip -->
    <section class="bg-gray-100 dark:bg-gray-800 py-12" aria-labelledby="skills-heading">
      <div class="container mx-auto px-4">
        <h2 id="skills-heading" class="text-2xl md:text-3xl font-bold mb-6 text-center text-gray-900 dark:text-gray-100">
          Skills
        </h2>
        <ul class="flex flex-wrap justify-center gap-3">
          {skills.map((skill) => (
            <li class="px-3 py-2 bg-indigo-200 text-indigo-900 dark:bg-indigo-900 dark:text-indigo-100 rounded-full font-medium">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Layout>
