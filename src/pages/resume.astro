---
// src/pages/resume.astro
import Layout from '../components/Layout.astro';
import MicroLabel from '../components/MicroLabel.astro';
import { withBase } from '../utils/paths';
import { skillGroups } from '../data/skills';

const snapshot = [
  { label: 'Education', value: 'BS Artificial Intelligence (in progress)' },
  { label: 'Focus', value: 'Machine learning' },
  { label: 'Disciplines', value: 'ML, data, research, web design & dev' },
  { label: 'Tools', value: 'Python, C++, PyTorch, Kafka, FastAPI' },
  { label: 'Format', value: 'PDF' },
];
---
<Layout title="Resume — Rashid Ali" description="View and download Rashid Ali's resume.">
  <section class="page-hero">
    <div class="shell">
      <div class="hero__top">
        <MicroLabel text="Resume" />
        <span class="mono muted">Updated 2026</span>
      </div>

      <h1 class="display-1 page-hero__title" data-reveal>Rashid Ali</h1>

      <div class="page-hero__row" style="margin-top:var(--space-sm)">
        <p class="lede" data-reveal>
          ML engineer and researcher. The full resume is available as a PDF.
        </p>
        <a class="btn btn--solid" href={withBase('/assets/resume.pdf')} download>
          Download PDF <span class="btn__arrow" aria-hidden="true">&#8595;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="snapshot-heading">
    <div class="shell split">
      <div>
        <h2 id="snapshot-heading" class="mono" style="font-weight:400">Snapshot</h2>
      </div>

      <div>
        <ul class="stack-list" data-reveal>
          {snapshot.map((item) => (
            <li>
              <span>{item.label}</span>
              <span>{item.value}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="skills-heading">
    <div class="shell split">
      <div>
        <h2 id="skills-heading" class="mono" style="font-weight:400">Technical skills</h2>
      </div>

      <div>
        <ul class="stack-list" data-reveal>
          {skillGroups.map((group) => (
            <li>
              <span>{group.label}</span>
              <span>{group.value}</span>
            </li>
          ))}
        </ul>

        <p style="margin-top:2rem">
          <a class="text-link" href={withBase('/contact')}>
            Prefer a conversation? Get in touch <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
