---
// src/pages/index.astro
import Layout from '../components/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
let projects = [];
try {
  projects = await getCollection('projects');
} catch (e) {
  // placeholder if collection not found
}
---
<Layout title="Rashid Ali - ML Engineer & Researcher" description="Personal portfolio of Rashid Ali, ML engineer and research enthusiast.">
  <div class="min-h-screen flex flex-col">
    {/* Hero */}
    <section class="py-16 bg-gradient-to-r from-indigo-600 to-purple-700 text-white">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Hi, I'm Rashid Ali</h1>
        <p class="text-lg md:text-xl mb-8">
          ML engineer and research enthusiast building real‑world AI solutions.
        </p>
        <div class="flex justify-center space-x-4">
          <a href="/projects" class="px-6 py-2 bg-white text-indigo-600 font-semibold rounded hover:bg-gray-200">
            View Projects
          </a>
          <a href="/resume" class="px-6 py-2 bg-gray-800 text-white rounded hover:bg-gray-700">
            View Resume
          </a>
          <a href="/contact" class="px-6 py-2 text-white bg-gray-800 rounded hover:bg-gray-700">
            Contact
          </a>
        </div>
      </div>
    </section>

    {/* Featured Projects */}
    <section class="container mx-auto px-4 py-12">
      <h2 class="text-2xl font-bold mb-6 text-center">Featured Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>

    {/* Skills Strip */}
    <section class="container mx-auto px-4 py-12 bg-gray-100">
      <h2 class="text-2xl font-bold mb-6 text-center">Skills</h2>
      <div class="flex flex-wrap justify-center space-x-4">
        <span class="px-3 py-2 bg-indigo-200 text-indigo-800 rounded">ML</span>
        <span class="px-3 py-2 bg-purple-200 text-purple-800 rounded">Research</span>
        <span class="px-3 py-2 bg-blue-200 text-blue-800 rounded">Web</span>
        <span class="px-3 py-2 bg-green-200 text-green-800 rounded">Data</span>
      </div>
    </section>
  </div>
</Layout>