---
// src/pages/projects/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import MicroLabel from '../../components/MicroLabel.astro';
import { withBase } from '../../utils/paths';

export const getStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
};

const { project, next } = Astro.props;
const image = withBase(project.data.image);

const links = [
  { label: 'Source code', href: project.data.code },
  { label: 'Live demo', href: project.data.demo },
  { label: 'Paper', href: project.data.paper },
];
---
<Layout title={`${project.data.title} — Rashid Ali`} description={project.data.summary}>
  <section class="page-hero page-hero--dark grain" style="position:relative;overflow:hidden">
    <div class="hero__glow" style="top:58%;left:80%;opacity:.24" aria-hidden="true"></div>

    <div class="shell" style="position:relative;z-index:2">
      <div class="hero__top">
        <MicroLabel text="Case study" />
        <a class="mono" href={withBase('/projects')} style="text-decoration:none;opacity:.7">
          &#8592; All work
        </a>
      </div>

      <h1 class="display-1 case-title" data-reveal>{project.data.title}</h1>

      <p class="lede" style="margin-top:var(--space-sm); --d:1" data-reveal>
        {project.data.summary}
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="shell">
      <figure class="case-media">
        <img
          src={image}
          alt={project.data.imageAlt ?? `Preview image for ${project.data.title}`}
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
        {project.data.imageCredit && (
          <figcaption class="case-credit">
            Photo by{' '}
            {project.data.imageCreditUrl ? (
              <a href={project.data.imageCreditUrl} target="_blank" rel="noopener noreferrer">
                {project.data.imageCredit}
              </a>
            ) : (
              project.data.imageCredit
            )}{' '}
            on Unsplash
          </figcaption>
        )}
      </figure>

      <div class="case-grid">
        <div class="case-block">
          <h2 class="case-block__title">Tech stack</h2>
          <p class="copy">{project.data.tech}</p>
        </div>

        <div class="case-block">
          <h2 class="case-block__title">Links</h2>
          <ul class="case-links">
            {links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <span>{link.label}</span>
                  <span aria-hidden="true">&#8599;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a class="next-project" href={withBase(`/projects/${next.id}`)}>
        <MicroLabel text="Next project" />
        <span class="next-project__title">{next.data.title}</span>
      </a>
    </div>
  </section>
</Layout>
