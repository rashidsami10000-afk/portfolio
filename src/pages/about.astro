---
// src/pages/about.astro
import Layout from '../components/Layout.astro';
import MicroLabel from '../components/MicroLabel.astro';
import { withBase } from '../utils/paths';
import { Image } from 'astro:assets';
import portrait from '../assets/rashid-portrait.jpg';
import { skillGroups } from '../data/skills';

const disciplines = [
  { name: 'Machine learning', detail: 'Models, training, evaluation' },
  { name: 'Data pipelines', detail: 'Streaming, storage, cleaning' },
  { name: 'Experiments', detail: 'Papers into working code' },
  { name: 'Web design & development', detail: 'UI, layout, responsive front-end' },
];
---
<Layout title="About — Rashid Ali" description="About Rashid Ali, an Artificial Intelligence undergraduate building machine learning systems.">
  <section class="page-hero">
    <div class="shell">
      <div class="hero__top">
        <MicroLabel text="About" />
        <span class="mono muted">Rashid Ali</span>
      </div>

      <h1 class="display-1 page-hero__title" data-reveal>Research that ships.</h1>

      <div class="page-hero__row" style="margin-top:var(--space-sm)">
        <p class="lede" data-reveal>
          Artificial Intelligence undergraduate building machine learning systems — and the
          pipelines that keep them honest.
        </p>
        <a class="text-link" href={withBase('/contact')}>
          Work with me <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="profile-heading">
    <div class="shell split">
      <div>
        <MicroLabel text="Profile" />

        <figure class="profile-portrait">
          <div class="media-frame profile-portrait__frame">
            <Image
              src={portrait}
              alt="Portrait of Rashid Ali"
              widths={[320, 480, 640, 720]}
              sizes="(min-width: 900px) 20rem, 80vw"
              loading="lazy"
              decoding="async"
            />
          </div>
        </figure>
      </div>

      <div>
        <h2 id="profile-heading" class="statement" style="font-size:clamp(1.4rem,2.7vw,2.2rem)" data-reveal>
          I care most about the part where a model has to actually work.
        </h2>

        <div style="margin-top:2rem; --d:1" data-reveal>
          <p class="copy">
            I'm Rashid Ali, an Artificial Intelligence undergraduate at the University of
            Malakand. I build machine learning systems end to end — models, data pipelines,
            and the interfaces that make them usable.
          </p>
          <p class="copy">
            My path started with C++ and Python, then data structures, databases, and web
            development. The degree is in progress; the projects here are how I practise it.
          </p>
          <p class="copy">
            Outside of work I contribute to open-source projects, read research papers, and
            help newer developers get started.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="focus-heading">
    <div class="shell">
      <div class="panel panel--lime" data-reveal>
        <MicroLabel text="Current focus" />
        <h2 id="focus-heading" class="display-3" style="max-width:26ch;margin-top:1rem">
          Open to internships and junior roles where models actually reach production.
        </h2>
        <p style="margin-top:1.5rem">
          <a class="btn btn--solid" href={withBase('/contact')}>
            Get in touch <span class="btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="disciplines-heading">
    <div class="shell split">
      <div>
        <h2 id="disciplines-heading" class="mono" style="font-weight:400">Disciplines</h2>
      </div>

      <div>
        <ul class="stack-list" data-reveal>
          {disciplines.map((item) => (
            <li>
              <span>{item.name}</span>
              <span>{item.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="toolkit-heading">
    <div class="shell split">
      <div>
        <h2 id="toolkit-heading" class="mono" style="font-weight:400">Toolkit</h2>
      </div>

      <div>
        <ul class="stack-list" data-reveal>
          {skillGroups.map((group) => (
            <li>
              <span>{group.label}</span>
              <span>{group.value}</span>
            </li>
          ))}
        </ul>

        <p style="margin-top:2rem">
          <a class="text-link" href={withBase('/resume')}>
            View resume <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
