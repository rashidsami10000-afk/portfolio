---
// src/pages/index.astro
import Layout from '../components/Layout.astro';
import WorkRow from '../components/WorkRow.astro';
import MicroLabel from '../components/MicroLabel.astro';
import Marquee from '../components/Marquee.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';
import { splitWords } from '../utils/text';

const projects = await getCollection('projects');
const featured = projects.slice(0, 3);

const headline = splitWords('I build systems that learn.');

const services = [
  {
    title: 'Machine Learning',
    description: 'Model design, training, evaluation and deployment — from first experiment to production.',
  },
  {
    title: 'Data Engineering',
    description: 'Pipelines, streaming systems and the infrastructure that keeps models fed with clean data.',
  },
  {
    title: 'Applied Research',
    description: 'Reading papers, running experiments and turning findings into software people can use.',
  },
  {
    title: 'Web',
    description: 'Interfaces and dashboards that make models usable by people who are not engineers.',
  },
];

const stack = [
  'Python',
  'PyTorch',
  'scikit-learn',
  'FastAPI',
  'Kafka',
  'Spark',
  'Docker',
  'PostgreSQL',
  'TypeScript',
  'React',
  'Astro',
  'Linux',
];

const facts = [
  { value: '03', label: 'Case studies' },
  { value: '04', label: 'Disciplines' },
  { value: '12', label: 'Technologies' },
  { value: '01', label: 'Goal: ship it' },
];
---
<Layout
  title="Rashid Ali — ML Engineer & Researcher"
  description="Portfolio of Rashid Ali, an ML engineer and researcher building practical, research-informed AI systems."
>
  <!-- Hero -->
  <section class="hero grain" aria-labelledby="hero-heading">
    <div class="hero__glow" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <div class="hero__top">
        <MicroLabel text="ML engineer &amp; researcher" />
        <span class="mono muted">Portfolio / 2026</span>
      </div>

      <h1 id="hero-heading" class="display-1 hero__title" data-reveal>
        {headline.map((word, i) => (
          <Fragment>
            <span class="word"><span style={`--i:${i}`}>{word}</span></span>{' '}
          </Fragment>
        ))}
      </h1>

      <div class="hero__bottom">
        <p class="lede" data-reveal style="--d:3">
          I build real-world AI systems — from data pipelines to models in production,
          grounded in research and measured against reality.
        </p>
        <div class="hero__actions" data-reveal style="--d:4">
          <a class="btn btn--light" href={withBase('/projects')}>
            View work <span class="btn__arrow" aria-hidden="true">&#8594;</span>
          </a>
          <a class="btn btn--ghost" href={withBase('/contact')}>
            Get in touch <span class="btn__arrow" aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>

      <div class="hero__meta" data-reveal style="--d:5">
        <ul class="mono">
          <li>Machine learning</li>
          <li>Data engineering</li>
          <li>Applied research</li>
        </ul>
        <span class="mono hero__scroll">Scroll</span>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-head">
        <h2 id="work-heading" class="display-2">Selected work</h2>
        <a class="text-link" href={withBase('/projects')}>
          All projects <span aria-hidden="true">&#8599;</span>
        </a>
      </div>

      <div class="work-list" data-reveal>
        {featured.map((project, i) => <WorkRow project={project} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section--tight" id="approach" aria-labelledby="approach-heading">
    <div class="shell split">
      <div>
        <MicroLabel text="Approach" />
      </div>
      <div>
        <h2 id="approach-heading" class="statement" data-reveal>
          Research is only useful when it <span class="hl">ships</span>. I build the
          pipeline, train the model, and put it in front of <em>real users.</em>
        </h2>

        <ul class="fact-grid" style="margin-top:var(--space-sm); --d:1" data-reveal>
          {facts.map((fact) => (
            <li class="fact">
              <span class="fact__value">{fact.value}</span>
              <span class="fact__label">{fact.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- What I do -->
  <section class="section section--tight" id="services" aria-labelledby="services-heading">
    <div class="shell">
      <div class="section-head">
        <h2 id="services-heading" class="display-2">What I do</h2>
        <MicroLabel text="Disciplines" />
      </div>

      <div class="service-list" data-reveal>
        {services.map((service, i) => (
          <div class="service">
            <span class="service__num">0{i + 1}</span>
            <h3 class="service__title">{service.title}</h3>
            <p class="service__desc">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="section--dark" aria-label="Technologies">
    <div style="padding-block:1.25rem">
      <Marquee items={stack} variant="mono" duration={42} />
    </div>
  </section>

  <!-- About teaser -->
  <section class="section" id="about" aria-labelledby="about-heading">
    <div class="shell split split--wide">
      <div>
        <MicroLabel text="About" />
        <h2 id="about-heading" class="display-2" style="margin-top:1rem" data-reveal>
          Machine learning, built to run.
        </h2>
      </div>

      <div data-reveal style="--d:1">
        <p class="copy">
          I'm Rashid Ali, an ML engineer and researcher. I build scalable AI systems and
          explore new algorithms, with a focus on turning research ideas into working
          software.
        </p>
        <p class="copy">
          My path started with programming, continued through a computer science degree,
          and now centres on connecting research breakthroughs with production-ready
          applications.
        </p>
        <p style="margin-top:1.5rem">
          <a class="text-link" href={withBase('/about')}>
            More about me <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
