---
// src/pages/projects/index.astro
import Layout from '../../components/Layout.astro';
import WorkRow from '../../components/WorkRow.astro';
import MicroLabel from '../../components/MicroLabel.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/paths';

const projects = await getCollection('projects');
const count = String(projects.length).padStart(2, '0');
---
<Layout
  title="Work — Rashid Ali"
  description="Selected machine learning and engineering projects by Rashid Ali."
>
  <section class="page-hero page-hero--dark grain" style="position:relative;overflow:hidden">
    <div class="hero__glow" style="top:72%;left:84%;opacity:.3" aria-hidden="true"></div>

    <div class="shell" style="position:relative;z-index:2">
      <div class="hero__top">
        <MicroLabel text="Archive" />
        <span class="mono muted">{count} projects</span>
      </div>

      <h1 class="display-1 page-hero__title" data-reveal>All work</h1>

      <div class="page-hero__row" style="margin-top:var(--space-sm)">
        <p class="lede" data-reveal>
          A selection of projects spanning machine learning, data pipelines, and applied
          research.
        </p>
        <a class="text-link" href={withBase('/contact')}>
          Start a conversation <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-label="Project list">
    <div class="shell">
      <div class="work-list" data-reveal>
        {projects.map((project, i) => <WorkRow project={project} index={i} />)}
      </div>
    </div>
  </section>
</Layout>
