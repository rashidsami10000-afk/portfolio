---
// src/pages/projects/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { withBase } from '../../utils/paths';

export const getStaticPaths = async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
};

const { project } = Astro.props;
---
<Layout
  title={`${project.data.title} — Rashid Ali`}
  description={project.data.summary}
>
  <article class="max-w-3xl mx-auto">
    <p class="mb-6 text-sm">
      <a href={withBase('/projects')} class="text-indigo-700 dark:text-indigo-300 underline-offset-4 hover:underline">
        ← Back to projects
      </a>
    </p>

    <h1 class="text-3xl md:text-4xl font-bold mb-3">{project.data.title}</h1>
    <p class="text-lg text-gray-700 dark:text-gray-300 mb-6">{project.data.summary}</p>

    <img
      src={withBase(project.data.image)}
      alt={project.data.imageAlt ?? `Preview image for ${project.data.title}`}
      width="1200"
      height="675"
      class="w-full h-auto aspect-video object-cover rounded-lg mb-2"
    />
    {project.data.imageCredit && (
      <p class="text-xs text-gray-600 dark:text-gray-400 mb-8">
        Photo by{' '}
        {project.data.imageCreditUrl ? (
          <a href={project.data.imageCreditUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
            {project.data.imageCredit}
          </a>
        ) : (
          project.data.imageCredit
        )}{' '}
        on Unsplash
      </p>
    )}

    <h2 class="text-xl font-semibold mb-2">Tech stack</h2>
    <p class="mb-8 text-gray-800 dark:text-gray-200">{project.data.tech}</p>

    <h2 class="text-xl font-semibold mb-2">Links</h2>
    <ul class="flex flex-wrap gap-6">
      <li>
        <a href={project.data.code} target="_blank" rel="noopener noreferrer" class="text-indigo-700 dark:text-indigo-300 font-medium underline-offset-4 hover:underline">
          Source code<span class="sr-only"> for {project.data.title}</span>
        </a>
      </li>
      <li>
        <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-blue-700 dark:text-blue-300 font-medium underline-offset-4 hover:underline">
          Live demo<span class="sr-only"> of {project.data.title}</span>
        </a>
      </li>
      <li>
        <a href={project.data.paper} target="_blank" rel="noopener noreferrer" class="text-green-700 dark:text-green-300 font-medium underline-offset-4 hover:underline">
          Paper<span class="sr-only"> about {project.data.title}</span>
        </a>
      </li>
    </ul>
  </article>
</Layout>
