---
// src/pages/resume.astro
import Layout from '../components/Layout.astro';
import { withBase } from '../utils/paths';
---
<Layout title="Resume — Rashid Ali" description="View and download Rashid Ali's resume.">
  <section class="max-w-3xl mx-auto py-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">Resume</h1>
    <p class="text-lg text-gray-700 dark:text-gray-300 mb-6">
      The full resume is available as a PDF.
    </p>
    <p class="mb-6">
      <a
        href={withBase('/assets/resume.pdf')}
        download
        class="inline-block px-6 py-3 bg-indigo-700 text-white font-semibold rounded-lg hover:bg-indigo-800"
      >
        Download resume (PDF)
      </a>
    </p>
    <p class="text-sm text-gray-600 dark:text-gray-400">
      Note: this PDF is a placeholder — replace <code>public/assets/resume.pdf</code> with your real resume.
    </p>
  </section>
</Layout>
