---
// src/components/ProjectCard.astro
import { withBase } from '../utils/paths';

export interface Props {
  project: any;
}

const { project } = Astro.props;
const href = withBase(`/projects/${project.id}`);
---
<article class="flex flex-col border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow bg-white dark:bg-gray-800">
  <div class="relative w-full h-48 bg-gray-200 dark:bg-gray-700">
    <img
      src={project.data.image}
      alt={`Preview image for ${project.data.title}`}
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-semibold mb-2 text-gray-900 dark:text-gray-100">
      <a href={href} class="hover:text-indigo-600 dark:hover:text-indigo-300">{project.data.title}</a>
    </h3>
    <p class="text-gray-700 dark:text-gray-300 line-clamp-3">
      {project.data.summary}
    </p>
    <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
      <span class="font-semibold">Tech:</span> {project.data.tech}
    </p>
    <div class="mt-auto flex flex-wrap gap-4 pt-4 text-sm font-medium">
      <a href={project.data.code} target="_blank" rel="noopener noreferrer" class="text-indigo-700 dark:text-indigo-300 underline-offset-4 hover:underline">
        Code<span class="sr-only"> for {project.data.title}</span>
      </a>
      <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="text-blue-700 dark:text-blue-300 underline-offset-4 hover:underline">
        Demo<span class="sr-only"> for {project.data.title}</span>
      </a>
      <a href={project.data.paper} target="_blank" rel="noopener noreferrer" class="text-green-700 dark:text-green-300 underline-offset-4 hover:underline">
        Paper<span class="sr-only"> for {project.data.title}</span>
      </a>
    </div>
  </div>
</article>
