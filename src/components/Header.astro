---
// src/components/Header.astro
---
<header class="sticky top-0 bg-white dark:bg-gray-800 shadow-md">
  <nav class="container mx-auto flex justify-between items-center py-4">
    <a href="/" class="text-gray-800 dark:text-gray-200 font-semibold text-xl">
      Rashid Ali
    </a>
    <ul class="flex space-x-6">
      <li><a href="/projects" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-gray-100">Projects</a></li>
      <li><a href="/about" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-gray-100">About</a></li>
      <li><a href="/resume" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-gray-100">Resume</a></li>
      <li><a href="/contact" class="text-gray-600 dark:text-gray-300 hover:text-indigo-600 dark:hover:text-gray-100">Contact</a></li>
      <li>
        <button id="theme-toggle" class="text-gray-600 dark:text-gray-300" aria-label="Toggle dark mode">
          <span class="hidden dark:block">☀️</span>
          <span class="block dark:hidden">🌙</span>
        </button>
      </li>
    </ul>
  </nav>
</header>
<script>
  const toggle = document.getElementById('theme-toggle');
  toggle.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });
  // Initialize theme
  const saved = localStorage.getItem('theme');
  if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  }
</script>