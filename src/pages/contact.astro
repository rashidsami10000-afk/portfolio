---
// src/pages/contact.astro
import Layout from '../components/Layout.astro';
export const frontmatter = {
  title: "Contact",
  description: "Ways to get in touch"
};
---
<Layout title="Contact" description="Contact Rashid Ali via email, GitHub, or LinkedIn.">
  <section class="prose max-w-3xl mx-auto py-12">
    <h1 class="text-3xl font-bold mb-4">Contact Me</h1>
    <p class="text-lg mb-6">
      You can reach me via email, GitHub, or LinkedIn.
    </p>
    <ul class="flex flex-col space-y-4">
      <li>
        <a href="mailto:rashid.ali@example.com" class="text-indigo-600 hover:underline">
          rashid.ali@example.com
        </a>
      </li>
      <li>
        <a href="https://github.com/rashidsami10000" target="_blank" rel="noopener" class="text-indigo-600 hover:underline">
          GitHub
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/rashid-ali-9445903a1/" target="_blank" rel="noopener" class="text-indigo-600 hover:underline">
          LinkedIn
        </a>
      </li>
    </ul>
  </section>
</Layout>