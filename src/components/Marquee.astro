---
// src/components/Marquee.astro
interface Props {
  items: string[];
  /** mono: micro labels, display: oversized headlines */
  variant?: 'mono' | 'display';
  /** Seconds for one full loop. */
  duration?: number;
  /** Alternate solid / outlined words (display variant only). */
  outline?: boolean;
  className?: string;
}

const { items, variant = 'mono', duration = 30, outline = false, className = '' } = Astro.props;
const groups = [0, 1];
---
<div
  class:list={['marquee', `marquee--${variant}`, outline && 'marquee--outline', className]}
  style={`--marquee-duration:${duration}s`}
  aria-hidden="true"
>
  <div class="marquee__track">
    {groups.map(() => (
      <div class="marquee__group">
        {items.map((item) => (
          <span class="marquee__item">
            <span class="marquee__star">&#10035;</span>
            {item}
          </span>
        ))}
      </div>
    ))}
  </div>
</div>
