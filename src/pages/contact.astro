---
// src/pages/contact.astro
import Layout from '../components/Layout.astro';
import MicroLabel from '../components/MicroLabel.astro';
import { withBase } from '../utils/paths';

const email = 'rashid.ali@example.com';
const github = 'https://github.com/rashidsami10000-afk';
const linkedin = 'https://www.linkedin.com/in/rashid-ali-9445903a1/';
---
<Layout title="Contact — Rashid Ali" description="Contact Rashid Ali via email, GitHub, or LinkedIn.">
  <section class="page-hero page-hero--dark grain" style="position:relative;overflow:hidden;padding-bottom:var(--space-md)">
    <div class="hero__glow" style="top:40%;left:78%;opacity:.28" aria-hidden="true"></div>

    <div class="shell" style="position:relative;z-index:2">
      <div class="hero__top">
        <MicroLabel text="Contact" />
        <span class="mono muted">Open to work</span>
      </div>

      <h1 class="display-1 page-hero__title" data-reveal>Let's talk.</h1>

      <p class="lede" style="margin-top:var(--space-sm)" data-reveal>
        The best ways to reach me — for roles, collaborations, or a problem worth solving.
      </p>

      <p style="margin-top:var(--space-md)">
        <a class="footer-email" href={`mailto:${email}`}>{email}</a>
      </p>

      <div class="case-grid" style="margin-top:var(--space-sm)">
        <div class="case-block">
          <h2 class="case-block__title">Elsewhere</h2>
          <ul class="case-links">
            <li>
              <a href={github} target="_blank" rel="noopener noreferrer">
                <span>GitHub</span>
                <span aria-hidden="true">&#8599;</span>
              </a>
            </li>
            <li>
              <a href={linkedin} target="_blank" rel="noopener noreferrer">
                <span>LinkedIn</span>
                <span aria-hidden="true">&#8599;</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${email}`}>
                <span>Email</span>
                <span aria-hidden="true">&#8599;</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="case-block">
          <h2 class="case-block__title">Details</h2>
          <ul class="stack-list" style="border-color:rgba(249,244,235,.18)">
            <li style="border-color:rgba(249,244,235,.18)">
              <span>Status</span>
              <span>Open to work</span>
            </li>
            <li style="border-color:rgba(249,244,235,.18)">
              <span>Focus</span>
              <span>ML &amp; data</span>
            </li>
            <li style="border-color:rgba(249,244,235,.18)">
              <span>Reply time</span>
              <span>Within 48 hours</span>
            </li>
          </ul>
        </div>
      </div>

      <p style="margin-top:var(--space-md)">
        <a class="text-link" href={withBase('/projects')}>
          Or start with the work <span aria-hidden="true">&#8594;</span>
        </a>
      </p>
    </div>
  </section>
</Layout>
